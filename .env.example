# API Configuration (optional off-chain metadata/indexer; the protocol itself is on-chain)
VITE_API_BASE_URL=http://localhost:3000

# Stellar Network Configuration
# Options: testnet, mainnet, futurenet
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed PawnLoan smart contract (Contract ID, starts with C...)
VITE_PAWNLOAN_CONTRACT_ID=

# Default loan-denomination token contract (e.g. testnet USDC or native XLM SAC)
VITE_LOAN_TOKEN_ID=
